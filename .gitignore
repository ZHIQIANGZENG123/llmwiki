# impeccable skill artifacts
.impeccable/
PRODUCT.md

# --- Local build/ops artifacts (not part of the source) ---
/.tmp/
# The pi agent runtime is a 24 MB install tree, fetched per machine with npm.
/.pi-runtime/
# Everything in the agent dir is local scratch — auth.json holds credentials, work/ is the
# chat agent's cwd — except the three files that configure it. Those carry no secrets: the
# API key comes from DEEPSEEK_API_KEY and the MCP token from ${LLMWIKI_TOKEN}.
/.pi-agent/*
!/.pi-agent/models.json
!/.pi-agent/mcp.json
!/.pi-agent/APPEND_SYSTEM.md
/web-patch/
/bundle*/
/devkit*/
*.tar
*.tar.gz
/web/tsconfig.tsbuildinfo